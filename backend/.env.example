# LedgerSnap Environment Configuration
# Add these keys to your .env file or deployment platform (Railway / Render / Cloudflare)

# Lemon Squeezy Configuration (https://app.lemonsqueezy.com/settings/api)
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_VARIANT_ID_SINGLE=your_variant_id_for_single_pass
LEMONSQUEEZY_VARIANT_ID_PRO=your_variant_id_for_pro_monthly
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# (Optional / Legacy) Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloud Managed Database (PostgreSQL - Supabase / Neon / Railway / Render)
# Set DATABASE_URL to make user licenses, free usage limits, and conversion cache 100% persistent across deployments!
# Example Supabase: postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Example Neon: postgresql://user:password@ep-cool-fog-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Example Railway/Render: auto-injected when adding PostgreSQL service
DATABASE_URL=

# Port (default 8000)
PORT=8000
